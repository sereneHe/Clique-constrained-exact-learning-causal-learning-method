#!/bin/bash
#PBS -N clique_shard
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=2:mem=32gb:scratch_local=30gb
#PBS -j oe

# Submit with, for example:
# qsub -v EXPERIMENT_KIND=er_sf,SHARD_INDEX=0,SHARD_COUNT=12 run_clique_shard_metacentrum.pbs
# qsub -v EXPERIMENT_KIND=real,SHARD_INDEX=0,SHARD_COUNT=5 run_clique_shard_metacentrum.pbs

set -euo pipefail

PROJECT=/storage/praha1/home/hexiaoyu/project-bestdagsolverintheworld
WORK=$SCRATCHDIR/project-bestdagsolverintheworld
EXPERIMENT_KIND=${EXPERIMENT_KIND:?Set EXPERIMENT_KIND to er_sf or real}
SHARD_INDEX=${SHARD_INDEX:?Set SHARD_INDEX}

case "$EXPERIMENT_KIND" in
  er_sf)
    SHARD_COUNT=${SHARD_COUNT:-12}
    EXPERIMENT_SCRIPT=scripts/experiments_clique_er_sf_multiseed.sh
    ;;
  real)
    SHARD_COUNT=${SHARD_COUNT:-5}
    EXPERIMENT_SCRIPT=scripts/experiments_clique_real_benchmarks.sh
    ;;
  *)
    echo "Unknown EXPERIMENT_KIND=${EXPERIMENT_KIND}; expected er_sf or real" >&2
    exit 2
    ;;
esac

OUT=$PROJECT/metacentrum_runs/${EXPERIMENT_KIND}_shard_${SHARD_INDEX}_${PBS_JOBID}
mkdir -p "$OUT"

echo "Job $PBS_JOBID started at $(date)"
echo "Experiment: $EXPERIMENT_KIND shard $SHARD_INDEX/$SHARD_COUNT"
echo "Node: $(hostname -f)"
echo "Scratch: $SCRATCHDIR"

SYNC_PID=""
sync_outputs() {
  mkdir -p "$OUT/dagsolvers"
  rsync -a "$WORK/dagsolvers/multirun" "$WORK/dagsolvers/mlruns" \
    "$WORK/dagsolvers/results" "$WORK/dagsolvers/outputs" "$OUT/dagsolvers/" \
    2>/dev/null || true
}

finish() {
  status=$?
  if [ -n "$SYNC_PID" ]; then
    kill "$SYNC_PID" 2>/dev/null || true
    wait "$SYNC_PID" 2>/dev/null || true
  fi
  sync_outputs
  clean_scratch || true
  exit "$status"
}
trap finish EXIT

module add python
source "$PROJECT/.venv/bin/activate"

rsync -a \
  --exclude .git \
  --exclude .venv \
  --exclude metacentrum_runs \
  --exclude dagsolvers/multirun \
  --exclude dagsolvers/mlruns \
  --exclude dagsolvers/results \
  --exclude dagsolvers/outputs \
  "$PROJECT/" "$WORK/"

cd "$WORK/dagsolvers"
export PYTHONPATH="$WORK:$WORK/dagsolvers:${PYTHONPATH:-}"
export PYTHONNOUSERSITE=1
export HYDRA_FULL_ERROR=1
export MLFLOW_ALLOW_FILE_STORE=true
export GRB_LICENSE_FILE=/storage/praha1/home/hexiaoyu/gurobi.lic
export KMP_DUPLICATE_LIB_OK=TRUE
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2
export NUMEXPR_NUM_THREADS=2

while true; do
  sync_outputs
  sleep 300
done &
SYNC_PID=$!

SHARD_INDEX="$SHARD_INDEX" SHARD_COUNT="$SHARD_COUNT" \
  bash "$EXPERIMENT_SCRIPT"

echo "Job $PBS_JOBID finished at $(date)"
