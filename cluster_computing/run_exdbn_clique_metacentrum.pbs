#!/bin/bash
#PBS -N exdbn_clique
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=2:mem=32gb:scratch_local=30gb
#PBS -j oe

set -euo pipefail

PROJECT=/storage/praha1/home/hexiaoyu/project-bestdagsolverintheworld-test2
VENV=/storage/praha1/home/hexiaoyu/project-bestdagsolverintheworld/.venv
WORK=$SCRATCHDIR/project-bestdagsolverintheworld-test2
OUT=$PROJECT/metacentrum_runs/$PBS_JOBID

echo "Job $PBS_JOBID started at $(date)"
echo "Node: $(hostname -f)"
echo "Scratch: $SCRATCHDIR"

mkdir -p "$OUT"

SYNC_PID=""

sync_outputs() {
  mkdir -p "$OUT/dagsolvers"
  rsync -a "$WORK/dagsolvers/multirun" "$WORK/dagsolvers/mlruns" "$WORK/dagsolvers/results" "$OUT/dagsolvers/" 2>/dev/null || true
}

finish() {
  status=$?
  if [ -n "$SYNC_PID" ]; then
    kill "$SYNC_PID" 2>/dev/null || true
    wait "$SYNC_PID" 2>/dev/null || true
  fi
  echo "Copying outputs back..."
  sync_outputs
  clean_scratch || true
  exit "$status"
}

trap finish EXIT

module add python

source "$VENV/bin/activate"

rsync -a \
  --exclude .git \
  --exclude .venv \
  --exclude metacentrum_runs \
  --exclude dagsolvers/multirun \
  --exclude dagsolvers/mlruns \
  --exclude dagsolvers/results \
  "$PROJECT/" "$WORK/"

cd "$WORK/dagsolvers"

export PYTHONPATH="$WORK:$WORK/dagsolvers:${PYTHONPATH:-}"
export PYTHONNOUSERSITE=1
export HYDRA_FULL_ERROR=1
export MLFLOW_ALLOW_FILE_STORE=true
export GRB_LICENSE_FILE=/storage/praha1/home/hexiaoyu/gurobi.lic
export KMP_DUPLICATE_LIB_OK=TRUE

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2
export NUMEXPR_NUM_THREADS=2

echo "Using python: $(which python)"
echo "Running in: $(pwd)"
echo "PYTHONPATH=$PYTHONPATH"

while true; do
  sync_outputs
  sleep 60
done &
SYNC_PID=$!
echo "Background output sync started with PID $SYNC_PID"

bash scripts/experiments_A-G.sh

echo "Job $PBS_JOBID finished at $(date)"
